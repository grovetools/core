{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grovetools/core/config/forge-config",
  "$defs": {
    "ForgeBackupConfig": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Provision the GCS backup bucket",
          "default": false
        },
        "create_bucket": {
          "type": "boolean",
          "description": "Create the bucket rather than joining an existing one",
          "default": true
        },
        "bucket": {
          "type": "string",
          "description": "GCS bucket for forge backups (no gs:// prefix)"
        },
        "location": {
          "type": "string",
          "description": "GCS bucket location; empty means the VM's region"
        },
        "prefix": {
          "type": "string",
          "description": "Object prefix inside the bucket; empty means the VM name"
        },
        "schedule": {
          "type": "string",
          "description": "systemd OnCalendar expression for the backup timer",
          "default": "daily"
        },
        "retention_days": {
          "type": "integer",
          "description": "Delete backup objects older than this many days",
          "default": 180
        },
        "nearline_days": {
          "type": "integer",
          "description": "Move live objects to Nearline after this many days",
          "default": 30
        },
        "noncurrent_days": {
          "type": "integer",
          "description": "Delete superseded object versions after this many days",
          "default": 30
        },
        "local_keep": {
          "type": "integer",
          "description": "Snapshots retained on the VM's own disk",
          "default": 3
        },
        "stale_after": {
          "type": "string",
          "description": "Alert when LAST_SUCCESS is older than this",
          "default": "48h"
        },
        "ntfy_url": {
          "type": "string",
          "description": "ntfy base URL for backup failure alerts"
        },
        "ntfy_topic_command": {
          "type": "string",
          "description": "Shell command printing the ntfy topic; run on the laptop",
          "x-sensitive": true
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ForgeInfraConfig": {
      "properties": {
        "project": {
          "type": "string",
          "description": "GCP project id for the forge VM"
        },
        "zone": {
          "type": "string",
          "description": "GCP zone for the forge VM",
          "default": "us-east1-b"
        },
        "vm_name": {
          "type": "string",
          "description": "Forge VM instance name",
          "default": "grove-forge"
        },
        "machine_type": {
          "type": "string",
          "description": "GCE machine type",
          "default": "e2-medium"
        },
        "disk_size_gb": {
          "type": "integer",
          "description": "Boot disk size in GB",
          "default": 50
        },
        "image_family": {
          "type": "string",
          "description": "OS image family",
          "default": "debian-12"
        },
        "image_project": {
          "type": "string",
          "description": "Project owning the OS image",
          "default": "debian-cloud"
        },
        "ssh_user": {
          "type": "string",
          "description": "SSH login user on the forge VM"
        },
        "ssh_pubkey_file": {
          "type": "string",
          "description": "SSH public key granted access",
          "default": "~/.ssh/id_ed25519.pub"
        },
        "identity_file": {
          "type": "string",
          "description": "SSH private key used to reach the forge VM"
        },
        "cidr": {
          "type": "string",
          "description": "Operator CIDR allowed to reach SSH and the service ports (never 0.0.0.0/0)"
        },
        "service_account_email": {
          "type": "string",
          "description": "Existing service account to attach; empty means create a dedicated no-scope one"
        },
        "enable_iap_ssh": {
          "type": "boolean",
          "description": "Allow IAP TCP forwarding to tcp/22",
          "default": true
        },
        "syncd_ingress_enabled": {
          "type": "boolean",
          "description": "Create the public syncd ingress rule",
          "default": true
        },
        "forgejo_ingress_enabled": {
          "type": "boolean",
          "description": "Create the IAP Forgejo ingress rule",
          "default": true
        },
        "ssh_ingress": {
          "type": "string",
          "enum": [
            "cidr+iap",
            "iap",
            "cidr"
          ],
          "description": "SSH ingress source set: cidr+iap|iap|cidr",
          "default": "cidr+iap"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ForgePollConfig": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable the daemon forge poller",
          "default": false
        },
        "interval": {
          "type": "string",
          "description": "Gap between poll sweeps (Go duration)",
          "default": "5m"
        },
        "stale_after": {
          "type": "string",
          "description": "How long fetched forge data stays fresh (Go duration)",
          "default": "15m"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ForgeServicesConfig": {
      "properties": {
        "domain": {
          "type": "string",
          "description": "DNS name of the forge services VM"
        },
        "tls_mode": {
          "type": "string",
          "description": "TLS strategy: self-signed|acme",
          "default": "self-signed"
        },
        "acme_email": {
          "type": "string",
          "description": "ACME account email (tls_mode = acme)"
        },
        "acme_dns_provider": {
          "type": "string",
          "description": "lego DNS-01 provider code (tls_mode = acme)"
        },
        "forgejo": {
          "$ref": "#/$defs/ForgejoServiceConfig",
          "description": "Forgejo service on the forge VM"
        },
        "syncd": {
          "$ref": "#/$defs/ForgeSyncdServiceConfig",
          "description": "grove-syncd service on the forge VM"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ForgeSyncdServiceConfig": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Colocate grove-syncd on the forge VM",
          "default": true
        },
        "port": {
          "type": "integer",
          "description": "grove-syncd TLS bind port",
          "default": 8788
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ForgejoServiceConfig": {
      "properties": {
        "version": {
          "type": "string",
          "description": "Forgejo release version to install"
        },
        "sha256": {
          "type": "string",
          "description": "SHA-256 of the Forgejo release binary"
        },
        "http_port": {
          "type": "integer",
          "description": "Forgejo HTTP port",
          "default": 3000
        },
        "site_name": {
          "type": "string",
          "description": "Forgejo site name",
          "default": "grove forge"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "WireGuardConfig": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Join this machine to the owner-managed WireGuard mesh",
          "default": false
        },
        "address": {
          "type": "string",
          "description": "Owner-assigned WireGuard interface address in CIDR form"
        },
        "endpoint": {
          "type": "string",
          "description": "WireGuard hub endpoint as host:port"
        },
        "hub_public_key": {
          "type": "string",
          "description": "Base64 WireGuard public key of the hub"
        },
        "allowed_ips": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Routes sent through the hub (defaults to the subnet containing address)"
        },
        "dns": {
          "type": "string",
          "description": "Optional DNS server for wg-quick (empty by default)"
        },
        "persistent_keepalive": {
          "type": "integer",
          "maximum": 3600,
          "minimum": 1,
          "description": "WireGuard keepalive interval in seconds",
          "default": 25
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "properties": {
    "url": {
      "type": "string",
      "description": "Base URL of the self-hosted forge instance"
    },
    "remote_name": {
      "type": "string",
      "description": "Git remote name for the forge",
      "default": "forge"
    },
    "token_command": {
      "type": "string",
      "description": "Shell command that prints the forge API token (executed by the global daemon only)",
      "x-hint": "Prefer token_command over embedding a token in config",
      "x-sensitive": true
    },
    "provider": {
      "type": "string",
      "description": "Forge provider the daemon poller uses: auto|forgejo|github",
      "default": "auto"
    },
    "poll": {
      "$ref": "#/$defs/ForgePollConfig",
      "description": "Daemon read-only forge poller (PR + checks state)"
    },
    "infra": {
      "$ref": "#/$defs/ForgeInfraConfig",
      "description": "Terraform inputs for the grove forge services VM"
    },
    "services": {
      "$ref": "#/$defs/ForgeServicesConfig",
      "description": "Services colocated on the grove forge VM"
    },
    "backup": {
      "$ref": "#/$defs/ForgeBackupConfig",
      "description": "Off-VM GCS backup of the forge's durable state"
    },
    "wireguard": {
      "$ref": "#/$defs/WireGuardConfig",
      "description": "Owner-managed WireGuard mesh client (private key remains on the VM)"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "title": "Grove Forge Configuration",
  "description": "The typed [forge] extension namespace."
}
